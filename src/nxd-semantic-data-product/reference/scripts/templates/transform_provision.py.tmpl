    #             "/data-product/{{env}}/{{glossary_dp}}#/terms/subject")
    #   )

A storage output port requires at least one promised model. Promise the REAL
model the transform seeds (above) — NOT a marker. full_table_name("<model>") in
the transform targets the exact table produce-verification checks, so the
promise passes while the discover UI gets the full attribute / PII / glossary /
relationship surface.

============================================================================
registry.py  (flat at DP root) — the semantic registry the tools read
============================================================================

    from nxd.experimental.semantic import Agg, SemanticRegistry

    REGISTRY = (
        SemanticRegistry()
        .model(
            "subjects",
            grain="SUBJECT_ID",
            description="One row per clinical-trial subject. The subject spine.",
        )
        .dimension(
            "subject_country", model="subjects", column="SUBJECT_COUNTRY",
            type="string", description="Subject's country of enrollment.",
        )
        .dimension(
            "subject_mrn", model="subjects", column="SUBJECT_MRN",
            type="string", description="Subject medical record number (PII).",
            pii=True,
        )
        .metric(
            "subject_count", model="subjects", agg=Agg.COUNT_DISTINCT,
            column="SUBJECT_ID", description="Distinct number of subjects.",
        )
        # Joins: none for the spine. A downstream DP declares cross-DP joins here;
        # they resolve at QUERY time against the live mesh, never in the view DDL.
        .build()
    )
"""
