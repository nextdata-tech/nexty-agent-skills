provision.py  (flat at DP root) — @on_provision hook; DDL ONLY (table + view)
============================================================================

    # The @on_provision hook creates this DP's OWN table STRUCTURE + the
    # single-table semantic view. DDL ONLY — no data. Runs in Phase A, BEFORE the
    # transform. Idempotent: CREATE TABLE IF NOT EXISTS + CREATE OR REPLACE VIEW.
    # The hook param is named for the storage output port (snowflake); the
    # ProvisionOutputPortArgumentProvider injects it as a typed Snowflake handle.
    # The trailing `if __name__ == "__main__":` guard is REQUIRED — a
    # registered-but-never-invoked lifecycle hook is a hard ValidationError.
    from nxd import data_product
    from nxd.data_product.context import Snowflake

    _VIEW_NAME = "{{MODEL_UPPER}}_SEMANTIC"  # e.g. "SUBJECTS_SEMANTIC"
                                             # = SnowflakeDialect.default_view_name(REGISTRY)

    @data_product.on_provision()
    def provision(snowflake: Snowflake) -> None:
        from snowflake import connector

        if snowflake is None or not snowflake.schema:
            print("provision skipped — no Snowflake schema in context")
            return

        fqn = (
            f"{snowflake.database}.{snowflake.schema}."
            if snowflake.database else f"{snowflake.schema}."
        )

        conn = connector.connect(
            user=snowflake.user, account=snowflake.account,
            warehouse=snowflake.warehouse, role=snowflake.role,
            database=snowflake.database, schema=snowflake.schema,
            ocsp_fail_open=True, **snowflake.connector_params(),
        )
        try:
            cur = conn.cursor()
            try:
                # 1) Create the PROMISED `subjects` model's MANAGED table —
                #    STRUCTURE ONLY (no rows). full_table_name("subjects") is the
                #    EXACT table the storage driver verifies the promise against.
                managed = snowflake.full_table_name("subjects")
                cur.execute(
                    f"CREATE TABLE IF NOT EXISTS {managed} "
                    "(SUBJECT_ID NUMBER, SUBJECT_COUNTRY VARCHAR, SUBJECT_MRN VARCHAR)"
                )
                print(f"provisioned TABLE {managed}")

                # 2) Create the SINGLE-TABLE semantic view over the promised table.
                #    References ONLY this DP's own tables — NEVER a cross-DP JOIN.
                #    Hand-author the projection; cross-DP joins resolve at QUERY
                #    time via the live mesh, never at view-create time.
                cur.execute(
                    f"CREATE OR REPLACE VIEW {fqn}{_VIEW_NAME} AS "
                    "SELECT SUBJECT_ID AS SUBJECT_ID, "
                    "SUBJECT_COUNTRY AS SUBJECT_COUNTRY, "
                    "SUBJECT_MRN AS SUBJECT_MRN "
                    f"FROM {managed}"
                )
                print(f"provisioned single-table VIEW {fqn}{_VIEW_NAME}")
            finally:
                cur.close()
        finally:
            conn.close()


    if __name__ == "__main__":
        data_product.provision()

============================================================================
transform.py  (flat at DP root) — MANDATORY; SEEDS the ROWS (NO DDL) AND bundles siblings
============================================================================

    # The transform seeds the ROWS into the table the provision hook created:
    # TRUNCATE TABLE IF EXISTS + write_pandas. NO DDL — never CREATE TABLE, never
    # CREATE VIEW (a transform that re-provisions made DPs flap Started<->Failed).
    # The output-port promise is verified AFTER the transform, so the rows are
    # present in time. This .transform() is ALSO what bundles the sibling
    # registry.py / tools.py / provision.py modules into the image (the **/*.py
    # glob runs on the transform/compute path) — without it the rpc subprocess
    # raises `ModuleNotFoundError: No module named 'registry'`.
    import pandas as pd
    from nxd.data_product.context import Snowflake

    def transform(snowflake: Snowflake) -> None:
        from snowflake import connector
        from snowflake.connector.pandas_tools import write_pandas

        if snowflake is None or not snowflake.schema:
            print("transform skipped — no Snowflake schema in context")
            return

        # Hand-author the seed rows — the view (not the kernel) owns the shape.
        subjects = pd.DataFrame([
            {"SUBJECT_ID": 1, "SUBJECT_COUNTRY": "US", "SUBJECT_MRN": "MRN-0001"},
            {"SUBJECT_ID": 2, "SUBJECT_COUNTRY": "US", "SUBJECT_MRN": "MRN-0002"},
            {"SUBJECT_ID": 3, "SUBJECT_COUNTRY": "DE", "SUBJECT_MRN": "MRN-0003"},
            {"SUBJECT_ID": 4, "SUBJECT_COUNTRY": "FR", "SUBJECT_MRN": "MRN-0004"},
        ])

        conn = connector.connect(
            user=snowflake.user, account=snowflake.account,
            warehouse=snowflake.warehouse, role=snowflake.role,
            database=snowflake.database, schema=snowflake.schema,
            ocsp_fail_open=True, **snowflake.connector_params(),
        )
        try:
            # Truncate-and-load the PROMISED model's managed table (created by the
            # provision hook). full_table_name("subjects") targets the EXACT table
            # produce-verification checks. NO DDL here.
            managed = snowflake.full_table_name("subjects")
            cur = conn.cursor()
            try:
                cur.execute(f"TRUNCATE TABLE IF EXISTS {managed}")
            finally:
                cur.close()
            write_pandas(
                conn, subjects, managed.split(".")[-1].strip('"'),
                database=snowflake.database, schema=snowflake.schema,
            )
            print(f"seeded {managed} rows={len(subjects)}")
        finally:
            conn.close()

