"""Complete semantic-layer data product reference (flat layout).

This is the LIVE-PROVEN wiring for a deployable semantic DP — deployed Healthy
with `run_semantic_query` returning real rows on the local cluster. The code() /
sibling-bundling / flat-layout mechanics below are exactly what the proven
`pharma-subjects-demo` mesh DP ships (spec.py + tools.py + transform.py +
models.py + registry.py + provision.py, all flat siblings).

THE PROVISIONING PATH — seed at PROVISION time, in one launch:

  The kernel runs output-port promise verification BEFORE the transform. So the
  one-time setup the promise depends on — seeding this DP's OWN base table(s)
  AND creating the single-table <MODEL>_SEMANTIC view — happens in an
  `@on_provision` function (runs before verification + before the transform),
  wired via `.provision(script("provision.py"))`. This is the working path: it
  goes green in a SINGLE launch. The transform must NOT provision (verify has
  already run by then); a transform that re-seeds or re-creates the view is
  redundant and, on error/timeout, flaps the DP to State=Failed.

Four wiring constraints this template encodes (each is the difference between a
DP that LOOKS right and one that actually runs):

1. code() cannot extract closures. build_semantic_tools(REGISTRY) returns
   closures; pass code(<module-level tools.py fn>) instead and reuse the tools
   only for their .request_model / .response_model / .description.
2. The registry/tools siblings are bundled ONLY if there is a .transform(...).
   The rpc-output code() path ships only the extracted __<fn>__.py scripts; the
   **/*.py glob on the transform path bundles the siblings. So the transform is
   MANDATORY (even when it is a no-op).
3. All modules flat at the DP root — never a transform/ subdir package — so the
   extracted tool scripts resolve `from registry import REGISTRY` against the
   script dir (the only path on sys.path in the rpc subprocess).
4. Seed at PROVISION time via @on_provision — the transform must NOT provision.
   Promise verification runs BEFORE the transform, so the promised base table +
   the <MODEL>_SEMANTIC view must already exist by then. Seed them in
   provision.py; keep the transform free of any seeding / view DDL.

============================================================================
spec.py  (flat at DP root)
============================================================================

    from nxd.spec import (
        code, data_product, data_product_output, data_product_rpc_output,
        rpc_function, rpc_server, script, storage,
    )
    from nxd.experimental.semantic import build_semantic_tools
    from registry import REGISTRY
    from tools import list_models, describe_model, run_semantic_query
    from transform import transform
    from models import provision_marker

    INFRA_PROFILE = "{{infra_profile}}"
    SNOWFLAKE_SERVICE = "{{snowflake_service}}"

    # Used ONLY for the schema descriptors + descriptions — NOT for the callable.
    _tools = build_semantic_tools(REGISTRY)
    _tool_map = {t.name: t for t in _tools}

    _rpc = data_product_rpc_output()
    for _fn, _name in [
        (list_models, "list_models"),
        (describe_model, "describe_model"),
        (run_semantic_query, "run_semantic_query"),
    ]:
        _t = _tool_map[_name]
        _rpc = _rpc.function(
            rpc_function(code(_fn), _t.request_model, _t.response_model)
            .description(_t.description)
        )
    _rpc = _rpc.port(
        "mcp-api",
        rpc_server(f"/infra-profile/{INFRA_PROFILE}#/services/{{mcp_service}}")
        .enable_endpoints()
        .mcp_path("/mcp"),
    )

    _storage = (
        data_product_output()
        .promise(provision_marker)
        # Plain storage(...) — NO .config(...).as_view(...). The facade as_view
        # pattern is mutually exclusive with .transform(), and an rpc DP NEEDS
        # the transform (for sibling bundling). nxd validate rejects the pair.
        .port(
            "snowflake",
            storage(f"/infra-profile/{INFRA_PROFILE}#/services/{SNOWFLAKE_SERVICE}"),
        )
    )

    spec = (
        data_product(
            name="{{dp_name}}",
            domain="{{domain}}",
            description="{{description}}",
            version="0.1.0",
            infra_profile=INFRA_PROFILE,
            # FACTORY kwarg (NOT .compute(provision_timeout_secs=...) — that
            # signature doesn't exist). Cold provision builds snowflake-connector
            # +pandas and exceeds the 180s default -> Timeout -> Failed.
            provision_timeout_secs=600,
        )
        # PROVISION FIRST — seeds the marker + base table(s) AND creates the
        # single-table <MODEL>_SEMANTIC view, all BEFORE promise verification.
        .provision(
            script("provision.py").compute(f"/infra-profile/{INFRA_PROFILE}#/services/{{compute_service}}")
        )
        # MANDATORY — bundles registry.py/tools.py via the **/*.py glob, and
        # carries any RUNTIME data production. It must NEVER (re)provision.
        .transform(
            code(transform).compute(f"/infra-profile/{INFRA_PROFILE}#/services/{{compute_service}}")
        )
        .output(_storage)
        .output(_rpc)
    )

============================================================================
tools.py  (flat at DP root) — MODULE-LEVEL functions code() can extract
============================================================================

    from __future__ import annotations
    import json as _json
    from typing import Any

    from nxd.drivers.rpc import Request, Response, function, mcp
    # MODULE-LEVEL import of the typed Snowflake handle — REQUIRED. The rpc
    # runtime injects the storage-context arg BY TYPE; an untyped / Any param
    # gets a raw Context with no driver methods and run_semantic_query fails live.
    from nxd.data_product.context import Snowflake
    from registry import REGISTRY  # flat sibling import
    from nxd.experimental.semantic.compiler import (
        CompileError, compile_selection, semantic_view_query,
    )
    from nxd.experimental.semantic.dialect import SnowflakeDialect

    # NOTE: do NOT define a module-level `_DIALECT = SnowflakeDialect(...)` and
    # reference it from a tool. code() extraction drops module-level assignments
    # -> NameError at rpc-server load -> 0 tools registered. Build it INSIDE the
    # body (see run_semantic_query). Likewise, INLINE every @mcp.tool description.

    @function(name="list_models")
    @mcp.tool(name="list_models", description="List every semantic model (grain) this data product exposes — each with its grain definition, metric count, dimension count, and join topology. A MODEL is the fundamental unit: every metric and every dimension lives under exactly one model. Call this first to orient yourself, then call describe_model on the model whose grain matches your question.")
    def list_models(request: Request) -> Response:
        out = []
        for m in REGISTRY.models:
            out.append({
                "name": m.name,
                "grain": m.grain,
                "description": m.description,
                "metric_count": len(REGISTRY.metrics_of(m.name)),
                "dimension_count": len(REGISTRY.dimensions_of(m.name)),
                "joins": [
                    {"to": j.right, "cardinality": j.cardinality.value}
                    for (j, _reached) in REGISTRY.joins_of(m.name)
                ],
            })
        return Response({"models": out})

    @function(name="describe_model")
    @mcp.tool(name="describe_model", description="Describe a single semantic model in full: its grain, every metric it owns (with aggregation, description, and the exact set of dimensions each metric can be sliced by), every own dimension (type, PII flag, description), and every documented join with the set of dimensions it makes reachable. CHASM-TRAP RULE: metrics from two different models must NEVER be combined in one run_semantic_query call. Call describe_model before run_semantic_query to pick a valid metric + dimension combination from the same model.")
    def describe_model(request: Request) -> Response:
        name = request.get("name") or ""
        model_obj = REGISTRY.model_of(name)
        if model_obj is None:
            known = ", ".join(m.name for m in REGISTRY.models)
            return Response({"name": name, "error": f"unknown model {name!r}. Known models: {known}."})
        # ... build metrics / dimensions / joins from REGISTRY (see reference DP)
        return Response({"name": model_obj.name, "grain": model_obj.grain, "error": ""})

    @function(name="run_semantic_query")
    @mcp.tool(name="run_semantic_query", description="THE DEFAULT, SAFE way to answer a question about this data product. Name CONCEPTS and the data product writes correct, governed SQL — you never write SQL on this path.\n\nARGS:\n- measures (REQUIRED): list of metric names from describe_model.\n- dimensions (optional): list of dimension names from describe_model to group by. OMIT IT (or pass []) for a grand total.\n- filters (optional): list of {\"dimension\": <name>, \"op\": <symbol>, \"value\": <val>}. The 'op' field MUST be one of: '=', '!=', '>', '>=', '<', '<=', 'IN', 'LIKE', 'ILIKE'.\n\nDo not mix metrics from different models in one call.")
    def run_semantic_query(snowflake: Snowflake, request: Request) -> Response:
        from snowflake import connector

        # Dialect built INSIDE the body (NOT at module level — code() drops it).
        _DIALECT = SnowflakeDialect(view_name=SnowflakeDialect.default_view_name(REGISTRY))
        cap = 200

        def _error(message: str, sql: str = "") -> Response:
            return Response({
                "compiled_sql": sql, "row_count": 0, "truncated": False,
                "columns": [], "rows": [], "error": message,
            })

        selection = {
            "measures": request.get("measures") or [],
            "dimensions": request.get("dimensions") or [],
            "filters": request.get("filters") or [],
        }
        if not selection["measures"]:
            return _error("No measures selected. Provide at least one metric name from describe_model in 'measures'.")
        if snowflake is None:
            return _error("No Snowflake connection is available.")

        sf_database, sf_schema = snowflake.database, snowflake.schema
        fqn = f"{sf_database}.{sf_schema}." if sf_database else f"{sf_schema}."
        wrapped = ""
        conn = connector.connect(
            user=snowflake.user, account=snowflake.account,
            warehouse=snowflake.warehouse, role=snowflake.role,
            database=sf_database, schema=sf_schema, ocsp_fail_open=True,
            session_parameters={"STATEMENT_TIMEOUT_IN_SECONDS": 60},
            **snowflake.connector_params(),
        )
        try:
            cur = conn.cursor()
            try:
                native = _DIALECT.supports_native_semantic_view(cur, fqn=fqn)
            except Exception:
                native = False
            try:
                if native:
                    sql = semantic_view_query(selection, registry=REGISTRY, dialect=_DIALECT, fqn=fqn)
                else:
                    sql = compile_selection(selection, registry=REGISTRY, dialect=_DIALECT, fqn=fqn, use_view=True)
            except CompileError as e:
                conn.close()
                return _error(f"Invalid selection: {e}")
            except Exception as e:
                conn.close()
                return _error(f"Compile failed: {e}")

            wrapped = f"SELECT * FROM (\n{sql}\n) AS _capped LIMIT {cap + 1}"
            try:
                cur.execute(wrapped)
                rows = list(cur.fetchall())
                columns = [str(c[0]) for c in cur.description]
            finally:
                conn.close()
        except Exception as e:
            return _error(f"Query failed: {e}", wrapped)

        truncated = len(rows) > cap
        if truncated:
            rows = rows[:cap]
        return Response({
            "compiled_sql": wrapped,
            "row_count": len(rows),
            "truncated": truncated,
            "columns": columns,
            "rows": [_json.dumps(list(r), default=str) for r in rows],
            "error": "",
        })

