    from nxd.spec import Predicate, attribute, semantic_model
    from nxd.spec.data_types import int64, string

    # The REAL subject-spine model the transform seeds (table SUBJECTS). We
    # promise THIS model on the storage port (not a dummy marker), so the discover
    # UI surfaces the actual attributes, their PII flags, glossary links, and (on
    # downstream facts) the cross-DP SEMANTIC RELATIONSHIP.
    subjects_model = (
        semantic_model("subjects")
        .description("Subject spine — one row per enrolled clinical-trial subject.")
        .schema({
            "SUBJECT_ID": int64(),
            "SUBJECT_COUNTRY": string(),
            "SUBJECT_MRN": string(),  # PII: medical record number.
        })
        # Glossary links at the model + attribute level (render in the UI).
        .link(Predicate.GlossaryTerm,
              "/data-product/{{env}}/{{glossary_dp}}#/terms/subject")
        .link("SUBJECT_COUNTRY", Predicate.GlossaryTerm,
              "/data-product/{{env}}/{{glossary_dp}}#/terms/subject_country")
    )

    # --- DOWNSTREAM VARIANT: cross-DP FK via .referencing(...) ------------------
    # A downstream fact/crosswalk model carries cross-DP foreign keys with
    # attribute(...).referencing(...). The reference renders in the discover UI as
    # a "SEMANTIC RELATIONSHIP" and resolves at QUERY time — the seeded view still
    # references only this DP's own tables. Pair it with the .input(...).source()
    # on the spec (see spec.py downstream variant).
    #
    #   site_subjects_model = (
    #       semantic_model("site_subjects")
    #       .description("Crosswalk hub — one row per (site, subject) enrollment.")
    #       .schema({
    #           # SITE_ID -> this DP's own sites dimension.
    #           "SITE_ID": attribute(int64(), "SITE_ID").referencing(
    #               data_product="{{this_dp}}", model="sites", attribute=["SITE_ID"]
    #           ),
    #           # SUBJECT_ID -> cross-DP FK to the upstream subject spine.
    #           "SUBJECT_ID": attribute(int64(), "SUBJECT_ID").referencing(
    #               data_product="{{upstream_dp}}",
    #               model="subjects",
    #               attribute=["SUBJECT_ID"],
    #           ),
    #       })
    #       .link(Predicate.GlossaryTerm,
