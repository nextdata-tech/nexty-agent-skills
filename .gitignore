# AI coding agent configs
.adal/
.agents/
.augment/
.bob/
.claude/*
# ...but the internal scenario-authoring skills are meant to be shared: they are
# how a non-engineer contributes an eval scenario, so they have to be in the
# repo. Deliberately not under src/ -- AGENTS.md requires every src/<skill> to
# ship in current_pack and the README table, and these are internal tooling,
# not part of the pack.
!.claude/skills/
.codebuddy/
.commandcode/
.context/
.continue/
.cortex/
.crush/
.cursor/
.factory/
.goose/
.iflow/
.junie/
.kilocode/
.kiro/
.kode/
.mcpjam/
.mux/
.neovate/
.openhands/
.pi/
.pochi/
.qoder/
.qwen/
.roo/
.trae/
.vibe/
.windsurf/
.zencoder/

*.zip
.venv/
.env.example

# Local provider credentials for driver-operator runs (see
# evals/dp-scenarios/README.md). Only .env.example was listed here, so a real
# .env would have been committed. Never commit any of these.
.env
.env.local
.env.*.local

# Skill runtime
skills/
skills-lock.json
# `skills/` above is the runtime staging directory. It also matches
# .claude/skills/, which is the opposite of what we want: those are the
# internal scenario-authoring skills and they must be shared.
!.claude/skills/
!.claude/skills/**

# Private eval artifacts
evals/private/*
!evals/private/README.md

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# JetBrains IDEs
.idea/
*.iml

infra-profile-ecommerce-demo.yaml

# Eval runner cache
.eval-cache/

# Eval reports (generated)
eval*report*.json
pharma*report*.json

# Benchmark recorder crash-recovery/runtime artifacts
evals/benchmarks/.benchmark-index.lock
evals/benchmarks/.benchmark-publication.json
evals/benchmarks/..benchmark-publication.json.*
evals/benchmarks/.benchmark-staging/
evals/benchmarks/entries/.*.md.*
evals/benchmarks/records/.*.json.*
evals/benchmarks/.README.md.*
# MCP server venv. The LOCK is tracked: the semantic-contract job and the
# nightly canary both run `uv sync --locked` here before installing the NXD
# wheels on top, so an untracked lock would let CI resolve a different dependency
# set than a developer and turn a drift check into a moving target. The nxd
# wheels stay out of the lock — they are installed from the published artifact.
evals/mcp/.venv/

# Query-loop run transcripts (generated)
evals/query-loop/runs/

# Cross-DP join eval run outputs (generated)
evals/cross-dp-joins/runs/

# DuckDB eval fixtures are built at eval time from committed SQL seeds (build_fixture.py)
evals/public/*/fixtures/*.duckdb
evals/public/*/fixtures/*.duckdb.wal

# Skill build artifacts
build/

# local infra-profile secrets — never commit
.nxd/
.claude-pr/
