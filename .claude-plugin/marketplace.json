{
  "$schema": "https://json.schemastore.org/claude-code-marketplace-manifest.json",
  "name": "nexty",
  "owner": {
    "name": "Nextdata"
  },
  "description": "Nextdata AI skills for local desktop data-product workflows and deployed DataMesh workflows.",
  "plugins": [
    {
      "name": "nexty-agent-skills",
      "source": "./",
      "displayName": "Nexty AI Pro",
      "description": "Compatibility bundle containing the complete Nextdata AI skill set. Prefer Nexty Desktop or Nexty DataMesh for new installs.",
      "version": "0.52.5",
      "author": {
        "name": "Nextdata"
      }
    },
    {
      "name": "nexty-desktop",
      "source": "./src",
      "strict": false,
      "skills": [
        "./nxd-build-semantic-data-product",
        "./nxd-generate-data-product",
        "./nxd-render-static-artifact",
        "./nxd-review-closure",
        "./nxd-run-job-loop",
        "./nxd-semantic-query-intent"
      ],
      "displayName": "Nexty Desktop",
      "description": "Build, serve, query, refine, and export local data products through the Nexty Desktop supervisor.",
      "version": "0.52.5",
      "author": {
        "name": "Nextdata"
      }
    },
    {
      "name": "nexty-datamesh",
      "source": "./src",
      "strict": false,
      "skills": [
        "./nxd-add-expectations-and-promises",
        "./nxd-add-inputs",
        "./nxd-add-outputs",
        "./nxd-add-policies",
        "./nxd-analyze-mesh",
        "./nxd-build-data-product",
        "./nxd-build-semantic-data-product",
        "./nxd-debug-data-product",
        "./nxd-fix-policy-failures",
        "./nxd-query-data-product",
        "./nxd-run-evals",
        "./nxd-semantic-query-intent",
        "./nxd-setup-cli",
        "./nxd-toggle-policies"
      ],
      "displayName": "Nexty DataMesh",
      "description": "Set up, inspect, build, govern, debug, evaluate, and query data products on a deployed Nextdata DataMesh.",
      "version": "0.52.5",
      "author": {
        "name": "Nextdata"
      }
    }
  ]
}
