# Run-scoped ledgers and landed CSV. Per-attempt records reference source
# content and must never be committed — see REVIEW.md M-6.
runs/
__pycache__/
*.pyc

# Local credentials for live-provider runs. NEVER commit — the anthropic
# provider reads ANTHROPIC_API_KEY from here via `set -a; . ./.env`.
.env
.env.*

# Isolated venv for live-API runs; the pinned desktop venv has no `anthropic`.
.venv-live/

# E2E scratch: duckdb file, dlt state, and a run ledger. Same reason as runs/.
examples/e2e/_run/
examples/e2e/_transform_run/
examples/e2e/_blockproof/
examples/e2e/_atomicity/
examples/e2e/_atomicity_stale/
