# Agent briefs and codex logs: working notes, not part of the suite.
.briefs/

# Python / uv build and cache artifacts.
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Generated at harness start from a pinned seed, never committed: large or
# hostile fixture data is reproducible from synthgen, so only small
# hand-inspectable goldens belong in git.
.nexty-test-data/
scenarios/.nexty-test-data/
scenarios/.drift-canary-*/

# Provider credentials for --driver-model runs. Sourced by hand, never
# committed; the repo-root .gitignore covers these too, this is belt and braces
# because the key lives next to the runner that reads it.
.env
.env.local

# mutmut's instrumented copy of the tree (scripts/mutation_test.py) and the
# report the wrapper tees for CI. Both are regenerated on every run.
mutants/
mutation-report.txt
